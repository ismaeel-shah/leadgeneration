# MongoDB Atlas connection string (must be a replica set — all Atlas clusters are).
MONGODB_URI=mongodb+srv://user:password@cluster/leadflow?retryWrites=true&w=majority
# Generate with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-secret
# Public URL of the app (production only, if your Auth.js setup needs it).
AUTH_URL=http://localhost:3000
# "true" only while creating your account(s); anything else closes sign-up.
ALLOW_SIGNUP=true
